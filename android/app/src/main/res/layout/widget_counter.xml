<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯: 앱을 열지 않고 누르면 바로 기록된다 (CounterWidget이 글자·버튼을 바꾼다) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="PBS 기록"
            android:textColor="#14302D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="앱에서 측정 대상을 고르세요"
            android:textColor="#3F5653"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/w_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1B6862"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/w_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn"
        android:minHeight="48dp"
        android:text="앱 열기"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 늦은 시작 보정: 행동 진행 중에만 보임 (시작을 10초·30초·1분 앞당김) -->
    <LinearLayout
        android:id="@+id/w_adj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/w_adj10"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_soft"
            android:text="−10초"
            android:textColor="#14302D"
            android:textSize="13sp" />

        <Button
            android:id="@+id/w_adj30"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_soft"
            android:text="−30초"
            android:textColor="#14302D"
            android:textSize="13sp" />

        <Button
            android:id="@+id/w_adj60"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_soft"
            android:text="−1분"
            android:textColor="#14302D"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_sub1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_soft"
            android:text="−1"
            android:textColor="#14302D"
            android:textSize="14sp" />

        <Button
            android:id="@+id/w_sub2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_soft"
            android:text="회기 끝"
            android:textColor="#14302D"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
